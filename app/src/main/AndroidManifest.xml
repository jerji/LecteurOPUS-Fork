<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher2"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="card.opus.CardHistoryActivity"
            android:exported="true"
            android:label="LecteurOPUS"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="card.opus.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
        </activity>
        <activity
            android:name="card.opus.CardActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/AppTheme" >
        </activity>
        <activity
            android:name="card.opus.DataDumpActivity"
            android:exported="false"
            android:label="Card Data Dump"
            android:theme="@style/AppTheme" >
        </activity>
        <activity
            android:name="card.opus.WriteCardActivity"
            android:exported="false"
            android:label="Write Card"
            android:theme="@style/AppTheme" >
        </activity>
    </application>

</manifest>