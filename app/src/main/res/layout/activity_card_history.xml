<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/surfaceLight">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/cardHeaderBg"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher2"
            android:contentDescription="App icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LecteurOPUS"
            android:textColor="@color/cardHeaderText"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingLeft="12dp" />

        <TextView
            android:id="@+id/cardCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cardHeaderSubtext"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Scan button -->
    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@color/cardScanButton"
        android:textColor="@color/cardHeaderText"
        android:textSize="16sp"
        android:text="  Scan a Card"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:textAllCaps="false"
        android:elevation="2dp" />

    <!-- Import button -->
    <Button
        android:id="@+id/importButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@color/cardImportButton"
        android:textColor="@color/cardHeaderText"
        android:textSize="14sp"
        android:text="  Import Card"
        android:drawableStart="@android:drawable/ic_menu_add"
        android:drawablePadding="8dp"
        android:textAllCaps="false"
        android:elevation="2dp" />

    <!-- Export All button -->
    <Button
        android:id="@+id/exportAllButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@color/cardExportButton"
        android:textColor="@color/cardHeaderText"
        android:textSize="14sp"
        android:text="  Export All Cards"
        android:drawableStart="@android:drawable/ic_menu_save"
        android:drawablePadding="8dp"
        android:textAllCaps="false"
        android:elevation="2dp" />

    <!-- Deep scan hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:text="Long-press Scan for deep OPUS enumeration"
        android:textSize="11sp"
        android:textColor="@color/cardHintText" />

    <!-- Card list -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No cards scanned yet.\nTap the button above to scan your first card."
        android:textSize="16sp"
        android:textColor="@color/cardHintText"
        android:gravity="center"
        android:padding="48dp" />

    <ListView
        android:id="@+id/cardList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:clipToPadding="false" />

</LinearLayout>